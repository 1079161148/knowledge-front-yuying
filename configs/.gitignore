# .gitignore for Knowledge Base Project

# Node.js dependencies
node/
npm-debug.log
yarn-error.lock

# IDE/editor configurations
.vscode/
.idea/
*.sublime-project
*.workspace

# OS metadata
.DS_Store
Thumbs.db

# Build output
dist/
build/
coverage/
site/           # MkDocs 生成的静态站点
.mkdocs/        # MkDocs 缓存

# Environment variables
.env
.env.local
.env.development
.env.production

# Log files
*.log

# Temporary files
*.tmp
*.temp

# Cache directories
cache/
.tmp/

# P/npm specific
pnpm-lock.yaml
yarn.lock

# Windows thumbnail cache
Desktop.ini

# Python virtual environments (if used)
__pycache__/
*.pyc
.venv/
env/
